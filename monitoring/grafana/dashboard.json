{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Tick Processing Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(tick_processed_total{job=\"rust-service\"}[30s])",
          "legendFormat": "Rust",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "rate(tick_processed_total{job=\"go-service\"}[30s])",
          "legendFormat": "Go",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
    {
      "title": "Total Ticks Processed",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "tick_processed_total{job=\"rust-service\"}",
          "legendFormat": "Rust",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "tick_processed_total{job=\"go-service\"}",
          "legendFormat": "Go",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "area" }
    },
    {
      "title": "Processing Latency p95 (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(tick_processing_duration_seconds_bucket{service=\"rust\"}[30s]))",
          "legendFormat": "Rust p95",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.95, rate(tick_processing_duration_seconds_bucket{service=\"go\"}[30s]))",
          "legendFormat": "Go p95",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
